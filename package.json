{
  "name": "rtshtani",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~57.0.7",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "expo": "^57.0.8",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.8",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "i18next": "^26.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.77.0",
    "react-i18next": "^17.0.8",
    "react-native": "npm:react-native-tvos@0.86.0-2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "deps:sync": "expo install --fix",
    "expoUpgrade": "npx expo install expo@latest && npx expo install --fix && rm -rf node_modules .expo && npm install && npx expo-doctor",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:preview": "APP_VARIANT=preview expo prebuild --clean",
    "prebuild:prod": "APP_VARIANT=production expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:dev": "APP_VARIANT=development expo run:android",
    "android:dev:device": "APP_VARIANT=development expo run:android --device",
    "android:preview": "APP_VARIANT=preview expo run:android --variant release",
    "android:preview:device": "APP_VARIANT=preview expo run:android --variant release --device",
    "android:prod": "APP_VARIANT=production expo run:android --variant release",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "ios:dev:device": "APP_VARIANT=development expo run:ios --device",
    "ios:preview": "APP_VARIANT=preview expo run:ios --configuration Release",
    "ios:preview:device": "APP_VARIANT=preview expo run:ios --configuration Release --device",
    "ios:prod": "APP_VARIANT=production expo run:ios --configuration Release",
    "eas:build:dev": "eas build --profile development",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:prod": "eas build --profile production",
    "eas:android:dev": "eas build --platform android --profile development",
    "eas:ios:dev": "eas build --platform ios --profile development",
    "eas:android:preview": "eas build --platform android --profile preview",
    "eas:ios:preview": "eas build --platform ios --profile preview",
    "eas:android:prod": "eas build --platform android --profile production",
    "eas:ios:prod": "eas build --platform ios --profile production",
    "prebuild:tv:dev": "EXPO_TV=1 APP_VARIANT=development expo prebuild --clean",
    "prebuild:tv:preview": "EXPO_TV=1 APP_VARIANT=preview expo prebuild --clean",
    "prebuild:tv:prod": "EXPO_TV=1 APP_VARIANT=production expo prebuild --clean",
    "android:tv:dev": "EXPO_TV=1 APP_VARIANT=development expo run:android",
    "android:tv:dev:device": "EXPO_TV=1 APP_VARIANT=development expo run:android --device",
    "android:stb:dev": "EXPO_TV=1 APP_PLATFORM=androidstb APP_VARIANT=development expo run:android",
    "eas:android:tv:dev": "eas build --platform android --profile development_tv",
    "eas:android:tv:preview": "eas build --platform android --profile preview_tv",
    "eas:android:tv:prod": "eas build --platform android --profile production_tv",
    "eas:android:stb:preview": "eas build --platform android --profile preview_stb",
    "eas:android:stb:prod": "eas build --platform android --profile production_stb",
    "ota:export": "rm -rf dist && EXPO_PUBLIC_API_MODE=real expo export --source-maps --clear --output-dir dist",
    "ota:sourcemaps:preview": "eas env:exec preview 'sentry-expo-upload-sourcemaps dist'",
    "ota:sourcemaps:prod": "eas env:exec production 'sentry-expo-upload-sourcemaps dist'",
    "eas:update:dev": "eas update --channel development --environment development",
    "eas:update:preview": "eas update --channel preview --environment preview",
    "eas:update:prod": "eas update --channel production --environment production",
    "eas:update:withSentry:dev": "npm run ota:export && eas update --skip-bundler --channel development --environment development",
    "eas:update:withSentry:dev:android": "npm run ota:export -- --platform android && eas update --skip-bundler --channel development --environment development --platform android",
    "eas:update:withSentry:dev:ios": "npm run ota:export -- --platform ios && eas update --skip-bundler --channel development --environment development --platform ios",
    "eas:update:withSentry:preview": "npm run ota:export && npm run ota:sourcemaps:preview && eas update --skip-bundler --channel preview --environment preview",
    "eas:update:withSentry:preview:android": "npm run ota:export -- --platform android && npm run ota:sourcemaps:preview && eas update --skip-bundler --channel preview --environment preview --platform android",
    "eas:update:withSentry:preview:ios": "npm run ota:export -- --platform ios && npm run ota:sourcemaps:preview && eas update --skip-bundler --channel preview --environment preview --platform ios",
    "eas:update:withSentry:prod": "npm run ota:export && npm run ota:sourcemaps:prod && eas update --skip-bundler --channel production --environment production",
    "eas:update:withSentry:prod:android": "npm run ota:export -- --platform android && npm run ota:sourcemaps:prod && eas update --skip-bundler --channel production --environment production --platform android",
    "eas:update:withSentry:prod:ios": "npm run ota:export -- --platform ios && npm run ota:sourcemaps:prod && eas update --skip-bundler --channel production --environment production --platform ios",
    "eas:update:list:dev": "eas update:list --branch development",
    "eas:update:list:preview": "eas update:list --branch preview",
    "eas:update:list:prod": "eas update:list --branch production",
    "eas:update:help": "echo 'OTA publish:\\n  npm run eas:update:<dev|preview|prod>                        plain — eas-cli bundles (PREFERRED when the project has no Sentry)\\n  npm run eas:update:withSentry:<dev|preview|prod>[:android|:ios]  local export + Sentry source-map upload\\nAppend -- -m \"msg\"; omit -m to be prompted (defaults to your last git commit message). Add -- --platform ios|android to the plain ones.\\nNEVER drop --environment: eas-cli turns it into `expo export --clear`, which is what stops a stale Metro cache shipping the wrong bundle.'",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "clearMocks": true
  },
  "private": true
}
