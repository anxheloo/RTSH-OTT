# react-native is aliased to the react-native-tvos fork (see package.json) to
# enable Android TV / STB builds. npm can't match the fork *by name* against the
# many libraries that declare a `react-native` peer (its real name is
# react-native-tvos), so it raises spurious ERESOLVE conflicts. The fork is a
# strict superset and satisfies those peers in practice, so we relax npm's peer
# auto-resolution. This is the documented react-native-tvos + npm setup.
#
# TRADE-OFF: legacy-peer-deps also stops npm from AUTO-installing peer deps, so
# any peer that mainline react-native/mmkv used to pull in transitively must be
# declared EXPLICITLY in package.json (react-native-nitro-modules for mmkv,
# @react-native/jest-preset for RN's jest preset). Add such a peer to
# dependencies if a fresh install drops it.
legacy-peer-deps=true
