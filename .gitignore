# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example
# Sentry's own local-credentials file, read by the Xcode build phase
# (SENTRY_DOTENV_PATH) and by sentry-expo-upload-sourcemaps. It holds
# SENTRY_AUTH_TOKEN, which can publish releases to the org — and it matches
# NEITHER `.env` (exact) NOR `.env*.local`, so without this line it is tracked.
.env.sentry-build-plugin
sentry.properties

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Session state
.remember/
