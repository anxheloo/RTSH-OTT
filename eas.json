{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "channel": "development"
    },
    "simulator-ios": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview"
      },
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "channel": "production",
      "autoIncrement": true
    },
    "development_tv": {
      "extends": "development",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "preview_tv": {
      "extends": "preview",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "production_tv": {
      "extends": "production",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "preview_stb": {
      "extends": "preview",
      "env": {
        "EXPO_TV": "1",
        "APP_PLATFORM": "androidstb"
      }
    },
    "production_stb": {
      "extends": "production",
      "env": {
        "EXPO_TV": "1",
        "APP_PLATFORM": "androidstb"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "anxhelocenollari@gmail.com",
        "ascAppId": "6803853740",
        "appleTeamId": "65K2L4RTV3",
        "language": "en-US",
        "metadataPath": "store/store.config.js"
      },
      "android": {
        "serviceAccountKeyPath": "./rtsh-ott-5016e1d0e915.json",
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
