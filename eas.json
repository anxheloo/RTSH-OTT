{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "channel": "development"
    },
    "simulator-ios": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview"
      },
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "channel": "production",
      "autoIncrement": true
    },
    "development_tv": {
      "extends": "development",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "preview_tv": {
      "extends": "preview",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "production_tv": {
      "extends": "production",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "preview_stb": {
      "extends": "preview",
      "env": {
        "EXPO_TV": "1",
        "APP_PLATFORM": "androidstb"
      }
    },
    "production_stb": {
      "extends": "production",
      "env": {
        "EXPO_TV": "1",
        "APP_PLATFORM": "androidstb"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "ott@rtsh.al",
        "ascAppId": "6796258611",
        "appleTeamId": "KMS93Q3XB8",
        "language": "en-US",
        "metadataPath": "store/store.config.json"
      },
      "android": {
        "serviceAccountKeyPath": "TODO(anx 2026-08-06): Play service-account JSON path",
        "track": "internal"
      }
    }
  }
}
